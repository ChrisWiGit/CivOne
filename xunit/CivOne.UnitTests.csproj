<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<AssemblyName>CivOne.UnitTests</AssemblyName>
		<RootNamespace>CivOne</RootNamespace>
		<OutputType>Library</OutputType>
		<AllowUnsafeBlocks>false</AllowUnsafeBlocks>
		<LangVersion>latest</LangVersion>
		<RuntimeIdentifiers>win-x86;win-x64;osx-x64;linux-x64</RuntimeIdentifiers>
	</PropertyGroup>
	<PropertyGroup>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<AnalysisLevel>latest-all</AnalysisLevel>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<NoWarn>$(NoWarn),CA1515,CA1819,CA1065,CA1814,CA1307,CA1002,CA1034,CA1707</NoWarn>
	</PropertyGroup>

	<PropertyGroup Condition="'$(SuppressConsoleLogs)' == 'true'">
		<DefineConstants>$(DefineConstants);SUPPRESS_CONSOLE_LOGS</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
		<PackageReference Include="coverlet.collector" Version="6.0.2">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="xunit" Version="2.9.0" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\CivOne.csproj" />
		<ProjectReference Include="..\civtranslate-interactive\civtranslate-interactive.csproj" />
		<!--
			Built, but deliberately not referenced: the plugin tests load this assembly from disk into
			an isolated load context. Referencing it would put its types into the default context and
			make the isolation untestable.
		-->
		<ProjectReference Include="TestPlugin\CivOne.TestPlugin.csproj"
			ReferenceOutputAssembly="false"
			Private="false"
			SkipGetTargetFrameworkProperties="true" />
	</ItemGroup>

	<!-- The test plugin has its own sources; they must not be compiled into the test assembly. -->
	<ItemGroup>
		<Compile Remove="TestPlugin\**" />
		<None Remove="TestPlugin\**" />
	</ItemGroup>

	<!--
		Copy the built plugin next to the tests. The tests copy it from there into a temporary
		plugins directory, so each test gets its own directory and they cannot interfere.
	-->
	<Target Name="CopyTestPluginAssembly" AfterTargets="Build">
		<ItemGroup>
			<TestPluginAssembly Include="$(MSBuildThisFileDirectory)TestPlugin\bin\$(Configuration)\$(TargetFramework)\CivOne.TestPlugin.dll" />
		</ItemGroup>
		<Copy SourceFiles="@(TestPluginAssembly)"
			DestinationFolder="$(OutDir)testplugin"
			SkipUnchangedFiles="true"
			Condition="Exists('%(TestPluginAssembly.Identity)')" />
	</Target>

	<ItemGroup>
		<Content Include="earth.yml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<Compile Include="xunit/src/**/*.cs" />
	</ItemGroup>

</Project>
